<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <!-- Кооперативне скасування -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. START (Важка задача)" />

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. CANCEL (Скасувати)" />

    <Space android:layout_width="match_parent" android:layout_height="24dp"/>

    <!-- Ізоляція помилок -->
    <Button
        android:id="@+id/btnTestCrash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2-3. TEST CRASH (SupervisorScope)" />

    <Space android:layout_width="match_parent" android:layout_height="24dp"/>

    <!-- Глобальний обробник -->
    <Button
        android:id="@+id/btnGlobalCrash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="4. GLOBAL CRASH (CEH)" />

    <Button
        android:id="@+id/btnBonusTrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⭐ BONUS TRAP (Вкладений краш)"
        android:backgroundTint="#F44336" />

</LinearLayout>